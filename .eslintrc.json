{
  "root": true,
  "env": {
    "browser": true,
    "node": true,
    "es2022": true
  },
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module",
    "ecmaFeatures": {
      "jsx": true
    }
  },
  "ignorePatterns": [
    "node_modules/",
    ".next/",
    ".vercel/",
    "out/",
    "next-env.d.ts"
  ],
  "rules": {
    "no-debugger": "warn",
    "prefer-const": "warn"
  }
}